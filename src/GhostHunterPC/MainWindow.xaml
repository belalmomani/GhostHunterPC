                                                       TextWrapping="Wrap"
                                                       Margin="0,0,0,10" />

                                            <StackPanel>
                                                <StackPanel.Style>
                                                    <Style TargetType="StackPanel">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding DataContext.IsFingerprint, RelativeSource={RelativeSource AncestorType=Border}}" Value="True">
                                                                <Setter Property="Visibility" Value="Visible" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </StackPanel.Style>
                                                <TextBlock Text="{Binding BaselineLabel}"
                                                           Foreground="{DynamicResource PrimaryTextBrush}"
                                                           FontSize="16"
                                                           FontWeight="SemiBold" />
                                                <TextBlock Text="{Binding BaselineSummary}"
                                                           Foreground="{DynamicResource SecondaryTextBrush}"
                                                           TextWrapping="Wrap"
                                                           Margin="0,5,0,10" />
                                                <TextBlock Text="{Binding EmptyBaselineItemsLabel}"
                                                           Foreground="{DynamicResource SecondaryTextBrush}"
                                                           Margin="0,0,0,7">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding HasBaselineItems}" Value="True">
                                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                                <DataGrid x:Name="HistoryBaselineGrid"
                                                          ItemsSource="{Binding BaselineItems}"
                                                          AutoGenerateColumns="False"
                                                          CanUserAddRows="False"
                                                          IsReadOnly="True"
                                                          HeadersVisibility="Column"
                                                          GridLinesVisibility="Horizontal"
                                                          MaxHeight="280"
                                                          Background="{DynamicResource CardBrush}"
                                                          Foreground="{DynamicResource PrimaryTextBrush}"
                                                          RowBackground="{DynamicResource SurfaceBrush}"
                                                          AlternatingRowBackground="{DynamicResource CardBrush}"
                                                          BorderBrush="{DynamicResource BorderBrush}">
                                                    <DataGrid.Columns>
                                                        <DataGridTextColumn Header="{Binding DataContext.CategoryLabel, Source={x:Reference HistoryBaselineGrid}}" Binding="{Binding Category}" Width="100" />
                                                        <DataGridTextColumn Header="{Binding DataContext.KeyLabel, Source={x:Reference HistoryBaselineGrid}}" Binding="{Binding Key}" Width="200" />
                                                        <DataGridTextColumn Header="{Binding DataContext.DetailsLabel, Source={x:Reference HistoryBaselineGrid}}" Binding="{Binding Value}" Width="*" />
                                                        <DataGridTextColumn Header="{Binding DataContext.TimeLabel, Source={x:Reference HistoryBaselineGrid}}" Binding="{Binding CollectedAtLabel}" Width="160" SortMemberPath="CollectedAt" />
                                                    </DataGrid.Columns>
                                                </DataGrid>
                                                <TextBlock Text="{Binding ChangesLabel}"
                                                           Foreground="{DynamicResource PrimaryTextBrush}"
                                                           FontWeight="SemiBold"
                                                           Margin="0,12,0,7" />
                                                <TextBlock Text="{Binding EmptyChangesLabel}"
                                                           Foreground="{DynamicResource SecondaryTextBrush}"
                                                           Margin="0,0,0,7">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding HasChanges}" Value="True">
                                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                                <DataGrid x:Name="HistoryChangesGrid"
                                                          ItemsSource="{Binding Changes}"
                                                          AutoGenerateColumns="False"
                                                          CanUserAddRows="False"
                                                          IsReadOnly="True"
                                                          HeadersVisibility="Column"
                                                          GridLinesVisibility="Horizontal"
                                                          MaxHeight="300"
                                                          Background="{DynamicResource CardBrush}"
                                                          Foreground="{DynamicResource PrimaryTextBrush}"
                                                          RowBackground="{DynamicResource SurfaceBrush}"
                                                          AlternatingRowBackground="{DynamicResource CardBrush}"
                                                          BorderBrush="{DynamicResource BorderBrush}">
                                                    <DataGrid.Columns>
                                                        <DataGridTextColumn Header="{Binding DataContext.ChangesLabel, Source={x:Reference HistoryChangesGrid}}" Binding="{Binding Status}" Width="100" />
                                                        <DataGridTextColumn Header="{Binding DataContext.CategoryLabel, Source={x:Reference HistoryChangesGrid}}" Binding="{Binding Category}" Width="100" />
                                                        <DataGridTextColumn Header="{Binding DataContext.KeyLabel, Source={x:Reference HistoryChangesGrid}}" Binding="{Binding Key}" Width="200" />
                                                        <DataGridTextColumn Header="{Binding DataContext.BeforeLabel, Source={x:Reference HistoryChangesGrid}}" Binding="{Binding PreviousValue}" Width="*" />
                                                        <DataGridTextColumn Header="{Binding DataContext.AfterLabel, Source={x:Reference HistoryChangesGrid}}" Binding="{Binding CurrentValue}" Width="*" />
                                                        <DataGridTextColumn Header="{Binding DataContext.TimeLabel, Source={x:Reference HistoryChangesGrid}}" Binding="{Binding ObservedAtLabel}" Width="160" />
                                                    </DataGrid.Columns>
                                                </DataGrid>
                                            </StackPanel>

                                            <StackPanel Margin="0,12,0,0">
                                                <StackPanel.Style>
                                                    <Style TargetType="StackPanel">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding DataContext.IsTimeline, RelativeSource={RelativeSource AncestorType=Border}}" Value="True">
                                                                <Setter Property="Visibility" Value="Visible" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </StackPanel.Style>
                                                <TextBlock Text="{Binding TimelineLabel}"
                                                           Foreground="{DynamicResource PrimaryTextBrush}"
                                                           FontSize="16"
                                                           FontWeight="SemiBold"
                                                           Margin="0,0,0,8" />
                                                <WrapPanel Margin="0,0,0,8">
                                                    <TextBlock Text="{Binding TypeLabel}" VerticalAlignment="Center" Margin="0,0,6,6" />
                                                    <ComboBox ItemsSource="{Binding EventTypes}"
                                                              SelectedItem="{Binding SelectedEventType}"
                                                              MinWidth="180"
                                                              Padding="6,4"
                                                              Margin="0,0,12,6" />
                                                    <TextBlock Text="{Binding FromDateLabel}" VerticalAlignment="Center" Margin="0,0,6,6" />
                                                    <DatePicker SelectedDate="{Binding FromDate}" Margin="0,0,12,6" />
                                                    <TextBlock Text="{Binding ToDateLabel}" VerticalAlignment="Center" Margin="0,0,6,6" />
                                                    <DatePicker SelectedDate="{Binding ToDate}" Margin="0,0,8,6" />
                                                </WrapPanel>
                                                <TextBlock Text="{Binding EmptyTimelineLabel}"
                                                           Foreground="{DynamicResource SecondaryTextBrush}"
                                                           Margin="0,0,0,7">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding HasEvents}" Value="True">
                                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                                <DataGrid x:Name="HistoryEventsGrid"
                                                          ItemsSource="{Binding EventsView}"
                                                          AutoGenerateColumns="False"
                                                          CanUserAddRows="False"
                                                          IsReadOnly="True"
                                                          HeadersVisibility="Column"
                                                          GridLinesVisibility="Horizontal"
                                                          MinHeight="220"
                                                          MaxHeight="390"
                                                          Background="{DynamicResource CardBrush}"
                                                          Foreground="{DynamicResource PrimaryTextBrush}"
                                                          RowBackground="{DynamicResource SurfaceBrush}"
                                                          AlternatingRowBackground="{DynamicResource CardBrush}"
                                                          BorderBrush="{DynamicResource BorderBrush}">
                                                    <DataGrid.Columns>
                                                        <DataGridTextColumn Header="{Binding DataContext.TimeLabel, Source={x:Reference HistoryEventsGrid}}" Binding="{Binding TimeLabel}" Width="155" SortMemberPath="OccurredAt" />
                                                        <DataGridTextColumn Header="{Binding DataContext.TypeLabel, Source={x:Reference HistoryEventsGrid}}" Binding="{Binding Type}" Width="180" SortMemberPath="Type" />
                                                        <DataGridTextColumn Header="{Binding DataContext.SourceLabel, Source={x:Reference HistoryEventsGrid}}" Binding="{Binding Source}" Width="190" SortMemberPath="Source" />
                                                        <DataGridTextColumn Header="{Binding DataContext.DetailsLabel, Source={x:Reference HistoryEventsGrid}}" Binding="{Binding Details}" Width="*" />
                                                    </DataGrid.Columns>
                                                </DataGrid>
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>

                                    <Border Padding="18"
                                            Margin="0,0,0,16"
                                            Background="{DynamicResource SurfaceBrush}"
                                            BorderBrush="{DynamicResource BorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="14">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsReports}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <StackPanel DataContext="{Binding Reports}">
                                            <TextBlock Text="{Binding Description}"
                                                       Foreground="{DynamicResource SecondaryTextBrush}"
                                                       TextWrapping="Wrap"
                                                       Margin="0,0,0,14" />
                                            <TextBlock Text="{Binding SelectedReportLabel}"
                                                       Foreground="{DynamicResource PrimaryTextBrush}"
                                                       FontWeight="SemiBold"
                                                       Margin="0,0,0,6" />
                                            <ComboBox ItemsSource="{Binding ReportKinds}"
                                                      SelectedValuePath="Kind"
                                                      SelectedValue="{Binding SelectedKind}"
                                                      DisplayMemberPath="Label"
                                                      MinWidth="280"
                                                      HorizontalAlignment="Left"
                                                      Padding="8,6"
                                                      Margin="0,0,0,12" />
                                            <WrapPanel Margin="0,0,0,10">
                                                <Button Content="{Binding ExportCsvLabel}"
                                                        Command="{Binding ExportCsvCommand}"
                                                        Padding="12,8"
                                                        Margin="0,0,8,8"
                                                        Cursor="Hand" />
                                                <Button Content="{Binding ExportJsonLabel}"
                                                        Command="{Binding ExportJsonCommand}"
                                                        Padding="12,8"
                                                        Margin="0,0,8,8"
                                                        Cursor="Hand" />
                                            </WrapPanel>
                                            <TextBlock Text="{Binding PrivacyNotice}"
                                                       Foreground="{DynamicResource SecondaryTextBrush}"
                                                       TextWrapping="Wrap"
                                                       Margin="0,0,0,8" />
                                            <TextBlock Text="{Binding PdfUnavailable}"
                                                       Foreground="{DynamicResource SecondaryTextBrush}"
                                                       TextWrapping="Wrap"
                                                       Margin="0,0,0,10" />
                                            <TextBlock Text="{Binding Status}"
                                                       FlowDirection="LeftToRight"
                                                       Foreground="{DynamicResource PrimaryTextBrush}"
                                                       TextWrapping="Wrap"
                                                       Margin="0,0,0,5" />
                                            <TextBlock Text="{Binding ErrorMessage}"
                                                       Foreground="#FF9B9B"
                                                       TextWrapping="Wrap" />
                                        </StackPanel>
                                    </Border>

                                    <Border Padding="18"
                                            Margin="0,0,0,16"
                                            Background="{DynamicResource SurfaceBrush}"
                                            BorderBrush="{DynamicResource BorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="14">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsSettings}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <StackPanel DataContext="{Binding Settings}">
                                            <TextBlock Text="{Binding LanguageLabel}"
                                                       Foreground="{DynamicResource PrimaryTextBrush}"
                                                       FontWeight="SemiBold"
                                                       Margin="0,0,0,5" />
                                            <ComboBox ItemsSource="{Binding LanguageOptions}"
                                                      SelectedItem="{Binding SelectedLanguage}"
                                                      MinWidth="220"
                                                      HorizontalAlignment="Left"
                                                      Padding="8,6"
                                                      Margin="0,0,0,12" />
                                            <TextBlock Text="{Binding ThemeLabel}"
                                                       Foreground="{DynamicResource PrimaryTextBrush}"
                                                       FontWeight="SemiBold"
                                                       Margin="0,0,0,5" />
                                            <ComboBox ItemsSource="{Binding ThemeOptions}"
                                                      SelectedItem="{Binding SelectedTheme}"
                                                      MinWidth="220"
                                                      HorizontalAlignment="Left"
                                                      Padding="8,6"
                                                      Margin="0,0,0,12" />
                                            <TextBlock Text="{Binding MonitorIntervalLabel}"
                                                       Foreground="{DynamicResource PrimaryTextBrush}"
                                                       FontWeight="SemiBold"
                                                       Margin="0,0,0,5" />
                                            <ComboBox ItemsSource="{Binding MonitorIntervals}"
                                                      SelectedItem="{Binding SelectedMonitorInterval}"
                                                      MinWidth="220"
                                                      HorizontalAlignment="Left"
                                                      Padding="8,6"
                                                      Margin="0,0,0,12" />
                                            <CheckBox Content="{Binding SaveHistoryLabel}"
                                                      IsChecked="{Binding SaveHistory}"
                                                      Foreground="{DynamicResource PrimaryTextBrush}"
                                                      Margin="0,0,0,12" />
                                            <TextBlock Text="{Binding ExcludedFoldersLabel}"
                                                       Foreground="{DynamicResource PrimaryTextBrush}"
                                                       FontWeight="SemiBold"
                                                       Margin="0,0,0,6" />
                                            <TextBlock Text="{Binding LocalStorageLabel}"
                                                       Foreground="{DynamicResource SecondaryTextBrush}"
                                                       TextWrapping="Wrap"
                                                       Margin="0,0,0,8" />
                                            <TextBlock Text="{Binding StoragePath}"
                                                       FlowDirection="LeftToRight"
                                                       TextWrapping="Wrap"
                                                       Foreground="{DynamicResource SecondaryTextBrush}"
                                                       Margin="0,0,0,8" />
                                            <ItemsControl ItemsSource="{Binding ExcludedFolders}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <DockPanel Margin="0,0,0,5">
                                                            <Button Content="{Binding DataContext.RemoveFolderLabel, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                    Command="{Binding DataContext.RemoveExcludedFolderCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                    CommandParameter="{Binding}"
                                                                    DockPanel.Dock="Right"
                                                                    Padding="8,4"
                                                                    Margin="8,0,0,0" />
                                                            <TextBlock Text="{Binding}"
                                                                       FlowDirection="LeftToRight"
                                                                       Foreground="{DynamicResource SecondaryTextBrush}"
                                                                       VerticalAlignment="Center"
                                                                       TextWrapping="Wrap" />
                                                        </DockPanel>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                            <TextBlock Text="{Binding NoExcludedFoldersLabel}"
                                                       Foreground="{DynamicResource SecondaryTextBrush}"
                                                       Margin="0,0,0,7">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding HasExcludedFolders}" Value="True">
                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                            <Button Content="{Binding AddFolderLabel}"
                                                    Command="{Binding AddExcludedFolderCommand}"
                                                    HorizontalAlignment="Left"
                                                    Padding="12,8"
                                                    Margin="0,0,0,12"
                                                    Cursor="Hand" />
                                            <TextBlock Text="{Binding PrivacyLabel}"
                                                       Foreground="{DynamicResource PrimaryTextBrush}"
                                                       FontWeight="SemiBold"
                                                       Margin="0,0,0,5" />
                                            <TextBlock Text="{Binding PrivacyNotice}"
                                                       Foreground="{DynamicResource SecondaryTextBrush}"
                                                       TextWrapping="Wrap"
                                                       Margin="0,0,0,8" />
                                            <TextBlock Text="{Binding NotificationsLabel}"
                                                       Foreground="{DynamicResource PrimaryTextBrush}"
                                                       FontWeight="SemiBold"
                                                       Margin="0,0,0,4" />
                                            <TextBlock Text="{Binding NotificationsUnavailable}"
                                                       Foreground="{DynamicResource SecondaryTextBrush}"
                                                       TextWrapping="Wrap"
                                                       Margin="0,0,0,10" />
                                            <TextBlock Text="{Binding Status}"
                                                       Foreground="{DynamicResource PrimaryTextBrush}"
                                                       TextWrapping="Wrap"
                                                       Margin="0,0,0,5" />
                                            <TextBlock Text="{Binding ErrorMessage}"
                                                       Foreground="#FF9B9B"
                                                       TextWrapping="Wrap" />
                                        </StackPanel>
                                    </Border>

                                    <Border Padding="24"
                                            Margin="0,0,0,16"
                                            Background="{DynamicResource SurfaceBrush}"
                                            BorderBrush="{DynamicResource BorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="14">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsDashboard}" Value="False">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding IsInvestigator}" Value="True">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding IsOrganizer}" Value="True">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding IsDuplicates}" Value="True">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding IsMonitor}" Value="True">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding IsFingerprint}" Value="True">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding IsTimeline}" Value="True">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding IsReports}" Value="True">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding IsSettings}" Value="True">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <StackPanel>
                                            <TextBlock Text="{Binding EmptyStateTitle}"
                                                       Foreground="{DynamicResource PrimaryTextBrush}"
                                                       FontSize="17"
                                                       FontWeight="SemiBold" />
                                            <TextBlock Text="{Binding EmptyStateDescription}"
                                                       Foreground="{DynamicResource SecondaryTextBrush}"
                                                       FontSize="13"
                                                       TextWrapping="Wrap"
                                                       Margin="0,9,0,0" />
                                        </StackPanel>
                                    </Border>

                                    <Border Padding="20"
                                            Background="{DynamicResource SurfaceBrush}"
                                            BorderBrush="{DynamicResource BorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="14">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE946;"
                                                       FontFamily="Segoe MDL2 Assets"
                                                       Foreground="{DynamicResource AccentBrush}"
                                                       FontSize="16"
                                                       VerticalAlignment="Center"
                                                       Margin="0,0,12,0" />
                                            <TextBlock Text="{Binding WorkspaceNotice}"
                                                       Foreground="{DynamicResource SecondaryTextBrush}"
                                                       FontSize="13"
                                                       TextWrapping="Wrap"
                                                       VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </DataTemplate>
                        </ContentControl.ContentTemplate>
                    </ContentControl>
                </ScrollViewer>
            </Grid>
        </Border>

        <Border Grid.Column="{Binding SidebarColumn}"
                Background="{DynamicResource SidebarBackgroundBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1,0,0,0"
                FlowDirection="{Binding Direction}">
            <Grid Margin="20,26">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Margin="4,0,4,30">
                    <TextBlock Text="GHOST HUNTER"
                               Foreground="{DynamicResource PrimaryTextBrush}"
                               FontSize="20"
                               FontWeight="Bold" />
                    <TextBlock Text="PC"
                               Foreground="{DynamicResource AccentBrush}"
                               FontSize="12"
                               FontWeight="Bold"
                               Margin="0,4,0,0" />
                </StackPanel>

                <TextBlock Grid.Row="1"
                           Text="{Binding NavigationHeading}"
                           Foreground="{DynamicResource SecondaryTextBrush}"
                           FontSize="11"
                           FontWeight="SemiBold"
                           Margin="8,0,8,10" />

                <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding NavigationItems}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Style="{StaticResource NavigationButtonStyle}"
                                        Command="{Binding DataContext.SelectPageCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                        CommandParameter="{Binding}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="30" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0"
                                                   Text="{Binding IconGlyph}"
                                                   FontFamily="Segoe MDL2 Assets"
                                                   FontSize="15"
                                                   VerticalAlignment="Center"
                                                   HorizontalAlignment="Center" />
                                        <TextBlock Grid.Column="1"
                                                   Text="{Binding Label}"
                                                   FontSize="13"
                                                   VerticalAlignment="Center"
                                                   Margin="9,0,0,0" />
                                    </Grid>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <Border Grid.Row="3"
                        Padding="12"
                        Margin="0,18,0,0"
                        Background="{DynamicResource SurfaceBrush}"
                        CornerRadius="10">
                    <TextBlock Text="{Binding SidebarFooter}"
                               Foreground="{DynamicResource SecondaryTextBrush}"
                               FontSize="11"
                               TextWrapping="Wrap" />
                </Border>
            </Grid>
        </Border>
    </Grid>
</Window>
