<Window x:Class="GhostHunterPC.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding ProgramName}"
        Width="1280"
        Height="820"
        MinWidth="860"
        MinHeight="600"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource WindowBackgroundBrush}">
    <Window.Resources>
        <Style x:Key="NavigationButtonStyle" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="12,11" />
            <Setter Property="Margin" Value="0,2" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="9"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="{DynamicResource SurfaceBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
                            </Trigger>
                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="{DynamicResource AccentSoftBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid FlowDirection="LeftToRight">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="{Binding FirstColumnWidth}" />
            <ColumnDefinition Width="{Binding SecondColumnWidth}" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="{Binding MainContentColumn}"
                Background="{DynamicResource WindowBackgroundBrush}"
                FlowDirection="{Binding Direction}">
            <Grid Margin="34,28">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="0,0,0,26">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding CurrentPage.Title}"
                                   Foreground="{DynamicResource PrimaryTextBrush}"
                                   FontSize="25"
                                   FontWeight="SemiBold" />
                        <TextBlock Text="{Binding CurrentPage.Description}"
                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                   FontSize="13"
                                   TextWrapping="Wrap"
                                   Margin="0,7,0,0" />
                    </StackPanel>
                    <StackPanel Grid.Column="1"
                                Orientation="Horizontal"
                                VerticalAlignment="Center">
                        <Button Content="{Binding RefreshButtonLabel}"
                                Command="{Binding RefreshDeviceInfoCommand}"
                                Foreground="{DynamicResource PrimaryTextBrush}"
                                Background="{DynamicResource AccentSoftBrush}"
                                BorderBrush="{DynamicResource AccentBrush}"
                                BorderThickness="1"
                                Padding="13,9"
                                Margin="0,0,8,0"
                                Cursor="Hand">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Visibility" Value="Visible" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding CurrentPage.IsDashboard}" Value="False">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                        <Button Content="{Binding LanguageActionLabel}"
                                Command="{Binding ToggleLanguageCommand}"
                                Foreground="{DynamicResource PrimaryTextBrush}"
                                Background="{DynamicResource SurfaceBrush}"
                                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1"
                                Padding="13,9"
                                Margin="0,0,8,0"
                                Cursor="Hand" />
                        <Button Content="{Binding ThemeActionLabel}"
                                Command="{Binding ToggleThemeCommand}"
                                Foreground="{DynamicResource PrimaryTextBrush}"
                                Background="{DynamicResource SurfaceBrush}"
                                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1"
                                Padding="13,9"
                                Cursor="Hand" />
                    </StackPanel>
                </Grid>

                <ScrollViewer Grid.Row="1"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <ContentControl Content="{Binding CurrentPage}">
                        <ContentControl.ContentTemplate>
                            <DataTemplate>
                                <StackPanel>
                                    <ItemsControl ItemsSource="{Binding Cards}">
                                        <ItemsControl.Style>
                                            <Style TargetType="ItemsControl">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsDashboard}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </ItemsControl.Style>
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Width="228"
                                                        MinHeight="154"
                                                        Margin="0,0,16,16"
                                                        Padding="20"
                                                        Background="{DynamicResource CardBrush}"
                                                        BorderBrush="{DynamicResource BorderBrush}"
                                                        BorderThickness="1"
                                                        CornerRadius="14">
                                                    <StackPanel>
                                                        <TextBlock Text="{Binding Label}"
                                                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                                                   FontSize="13" />
                                                        <TextBlock Text="{Binding Value}"
                                                                   Foreground="{DynamicResource PrimaryTextBrush}"
                                                                   FontSize="21"
                                                                   FontWeight="SemiBold"
                                                                   TextWrapping="Wrap"
                                                                   Margin="0,18,0,0" />
                                                        <TextBlock Text="{Binding Detail}"
                                                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                                                   FontSize="12"
                                                                   TextWrapping="Wrap"
                                                                   Margin="0,9,0,0" />
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <Border Padding="18"
                                            Margin="0,0,0,16"
                                            Background="{DynamicResource SurfaceBrush}"
                                            BorderBrush="{DynamicResource BorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="14">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsDoItForMe}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <StackPanel DataContext="{Binding DoItForMe}">
                                            <TextBlock Text="{Binding Intro}"
                                                       Foreground="{DynamicResource SecondaryTextBrush}"
                                                       TextWrapping="Wrap"
                                                       Margin="0,0,0,10" />
                                            <TextBlock Text="{Binding SafetyNotice}"
                                                       Foreground="{DynamicResource SecondaryTextBrush}"
                                                       TextWrapping="Wrap"
                                                       Margin="0,0,0,16" />
                                            <TextBlock Text="{Binding ChooseTaskLabel}"
                                                       Foreground="{DynamicResource PrimaryTextBrush}"
                                                       FontSize="16"
                                                       FontWeight="SemiBold"
                                                       Margin="0,0,0,8" />
                                            <ItemsControl ItemsSource="{Binding Tasks}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Button Command="{Binding DataContext.SelectTaskCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                CommandParameter="{Binding}"
                                                                HorizontalContentAlignment="Stretch"
                                                                Padding="12"
                                                                Margin="0,0,0,7"
                                                                Background="{DynamicResource CardBrush}"
                                                                BorderBrush="{DynamicResource BorderBrush}"
                                                                BorderThickness="1"
                                                                Cursor="Hand">
                                                            <StackPanel>
                                                                <DockPanel>
                                                                    <TextBlock Text="{Binding Label}"
                                                                               Foreground="{DynamicResource PrimaryTextBrush}"
                                                                               FontWeight="SemiBold" />
                                                                    <TextBlock Text="{Binding AvailabilityLabel}"
                                                                               Foreground="{DynamicResource SecondaryTextBrush}"
                                                                               HorizontalAlignment="Right"
                                                                               Margin="12,0,0,0" />
                                                                </DockPanel>
                                                                <TextBlock Text="{Binding Description}"
                                                                           Foreground="{DynamicResource SecondaryTextBrush}"
                                                                           TextWrapping="Wrap"
                                                                           Margin="0,5,0,0" />
                                                            </StackPanel>
                                                        </Button>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>

                                            <Border Padding="14"
                                                    Margin="0,8,0,12"
                                                    Background="{DynamicResource CardBrush}"
                                                    BorderBrush="{DynamicResource BorderBrush}"
                                                    BorderThickness="1"
                                                    CornerRadius="10">
                                                <StackPanel>
                                                    <TextBlock Text="{Binding PlanHeading}"
                                                               Foreground="{DynamicResource PrimaryTextBrush}"
                                                               FontSize="16"
                                                               FontWeight="SemiBold"
                                                               Margin="0,0,0,8" />
                                                    <TextBlock Text="{Binding PlanPrompt}"
                                                               Foreground="{DynamicResource SecondaryTextBrush}"
                                                               TextWrapping="Wrap">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Visibility" Value="Visible" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding HasPlan}" Value="True">
                                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                    <TextBlock Text="{Binding PlanTaskLabel}"
                                                               Foreground="{DynamicResource PrimaryTextBrush}"
                                                               FontWeight="SemiBold"
                                                               TextWrapping="Wrap" />
                                                    <TextBlock Text="{Binding PlanDescription}"
                                                               Foreground="{DynamicResource SecondaryTextBrush}"
                                                               TextWrapping="Wrap"
                                                               Margin="0,6,0,0" />
                                                    <TextBlock Text="{Binding AvailabilityHeader}"
                                                               Foreground="{DynamicResource PrimaryTextBrush}"
                                                               FontWeight="SemiBold"
                                                               Margin="0,10,0,2" />
                                                    <TextBlock Text="{Binding PlanAvailability}"
                                                               Foreground="{DynamicResource SecondaryTextBrush}"
                                                               TextWrapping="Wrap" />
                                                    <TextBlock Text="{Binding ImpactHeader}"
                                                               Foreground="{DynamicResource PrimaryTextBrush}"
                                                               FontWeight="SemiBold"
                                                               Margin="0,10,0,2" />
                                                    <TextBlock Text="{Binding PlanImpact}"
                                                               Foreground="{DynamicResource SecondaryTextBrush}"
                                                               TextWrapping="Wrap" />
                                                    <TextBlock Text="{Binding UndoHeader}"
                                                               Foreground="{DynamicResource PrimaryTextBrush}"
                                                               FontWeight="SemiBold"
                                                               Margin="0,10,0,2" />
                                                    <TextBlock Text="{Binding PlanUndo}"
                                                               Foreground="{DynamicResource SecondaryTextBrush}"
                                                               TextWrapping="Wrap" />
                                                </StackPanel>
                                            </Border>
                                            <WrapPanel Margin="0,0,0,8">
                                                <Button Content="{Binding ConfirmLabel}"
                                                        Command="{Binding ConfirmCommand}"
                                                        Padding="12,8"
                                                        Margin="0,0,8,8"
                                                        Cursor="Hand" />
                                                <Button Content="{Binding CancelLabel}"
                                                        Command="{Binding CancelPlanCommand}"
                                                        Padding="12,8"
                                                        Margin="0,0,8,8"
                                                        Cursor="Hand" />
                                            </WrapPanel>
                                            <TextBlock Text="{Binding Status}"
                                                       Foreground="{DynamicResource PrimaryTextBrush}"
                                                       TextWrapping="Wrap"
                                                       Margin="0,0,0,6" />
                                            <TextBlock Text="{Binding ErrorMessage}"
                                                       Foreground="#FF9B9B"
                                                       TextWrapping="Wrap"
                                                       Margin="0,0,0,10" />
                                            <TextBlock Text="{Binding LogHeading}"
                                                       Foreground="{DynamicResource PrimaryTextBrush}"
                                                       FontSize="16"
                                                       FontWeight="SemiBold"
                                                       Margin="0,4,0,8" />
                                            <TextBlock Text="{Binding LogEmptyLabel}"
                                                       Foreground="{DynamicResource SecondaryTextBrush}"
                                                       Margin="0,0,0,8">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding HasActionLog}" Value="True">
                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                            <DataGrid x:Name="DoItForMeLogGrid"
                                                      ItemsSource="{Binding ActionLog}"
                                                      AutoGenerateColumns="False"
                                                      CanUserAddRows="False"
                                                      IsReadOnly="True"
                                                      HeadersVisibility="Column"
                                                      GridLinesVisibility="Horizontal"
                                                      MaxHeight="220"
                                                      Background="{DynamicResource CardBrush}"
                                                      Foreground="{DynamicResource PrimaryTextBrush}"
                                                      RowBackground="{DynamicResource SurfaceBrush}"
                                                      AlternatingRowBackground="{DynamicResource CardBrush}"
                                                      BorderBrush="{DynamicResource BorderBrush}">
                                                <DataGrid.Columns>
                                                    <DataGridTextColumn Header="{Binding DataContext.LogTimeHeader, Source={x:Reference DoItForMeLogGrid}}"
                                                                        Binding="{Binding Timestamp, StringFormat={}{0:g}}"
                                                                        Width="150" />
                                                    <DataGridTextColumn Header="{Binding DataContext.LogTaskHeader, Source={x:Reference DoItForMeLogGrid}}"
                                                                        Binding="{Binding TaskLabel}"
                                                                        Width="180" />
                                                    <DataGridTextColumn Header="{Binding DataContext.LogResultHeader, Source={x:Reference DoItForMeLogGrid}}"
                                                                        Binding="{Binding Result}"
                                                                        Width="*" />
                                                </DataGrid.Columns>
                                            </DataGrid>
                                        </StackPanel>
                                    </Border>

                                    <Border Padding="18"
                                            Margin="0,0,0,16"
                                            Background="{DynamicResource SurfaceBrush}"
                                            BorderBrush="{DynamicResource BorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="14">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsInvestigator}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <StackPanel DataContext="{Binding Investigator}">
                                            <TextBlock Text="{Binding PrivacyNotice}"
                                                       Foreground="{DynamicResource SecondaryTextBrush}"
                                                       FontSize="12"
                                                       TextWrapping="Wrap"
                                                       Margin="0,0,0,14" />

                                            <Grid Margin="0,0,0,12">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <Button Grid.Column="0"
                                                        Command="{Binding ChooseFolderCommand}"
                                                        Padding="12,9"
                                                        Margin="0,0,8,0"
                                                        Cursor="Hand"
                                                        Content="{Binding ChooseFolderLabel}" />
                                                <TextBox Grid.Column="1"
                                                         Text="{Binding SelectedFolder, Mode=OneWay}"
                                                         IsReadOnly="True"
                                                         Padding="10,8"
                                                         Margin="0,0,8,0"
                                                         VerticalContentAlignment="Center" />
                                                <Button Grid.Column="2"
                                                        Content="{Binding StartScanLabel}"
                                                        Command="{Binding StartScanCommand}"
                                                        Padding="12,9"
                                                        Margin="0,0,8,0"
                                                        Cursor="Hand">
                                                    <Button.Style>
                                                        <Style TargetType="Button">
                                                            <Setter Property="IsEnabled" Value="True" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsScanning}" Value="True">
                                                                    <Setter Property="IsEnabled" Value="False" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Button.Style>
                                                </Button>
                                                <Button Grid.Column="3"
                                                        Content="{Binding CancelScanLabel}"
                                                        Command="{Binding CancelScanCommand}"
                                                        Padding="12,9"
                                                        Cursor="Hand" />
                                            </Grid>

                                            <Grid Margin="0,0,0,10">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBox Grid.Column="0"
                                                         Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                                         Padding="10,8"
                                                         Margin="0,0,10,0"
                                                         ToolTip="{Binding SearchLabel}" />
                                                <TextBlock Grid.Column="1"
                                                           Text="{Binding ProgressLabel}"
                                                           Foreground="{DynamicResource SecondaryTextBrush}"
                                                           VerticalAlignment="Center" />
                                            </Grid>

                                            <ProgressBar Height="6"
                                                         Margin="0,0,0,10"
                                                         IsIndeterminate="{Binding IsScanning}">
                                                <ProgressBar.Style>
                                                    <Style TargetType="ProgressBar">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsScanning}" Value="True">
                                                                <Setter Property="Visibility" Value="Visible" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </ProgressBar.Style>
                                            </ProgressBar>

                                            <TextBlock Text="{Binding Status}"
                                                       Foreground="{DynamicResource PrimaryTextBrush}"
                                                       FontWeight="SemiBold"
                                                       Margin="0,0,0,8" />
                                            <TextBlock Text="{Binding ErrorMessage}"
                                                       Foreground="#FF9B9B"
                                                       TextWrapping="Wrap"
                                                       Margin="0,0,0,8" />
                                            <TextBlock Text="{Binding EmptyResultsLabel}"
                                                       Foreground="{DynamicResource SecondaryTextBrush}"
                                                       TextWrapping="Wrap"
                                                       Margin="0,0,0,8">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding HasResults}" Value="True">
                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>

                                            <DataGrid ItemsSource="{Binding ResultsView}"
                                                      SelectedItem="{Binding SelectedResult, Mode=TwoWay}"
                                                      AutoGenerateColumns="False"
                                                      CanUserSortColumns="True"
                                                      CanUserAddRows="False"
                                                      IsReadOnly="True"
                                                      SelectionMode="Single"
                                                      HeadersVisibility="Column"
                                                      GridLinesVisibility="Horizontal"
                                                      MinHeight="260"
                                                      MaxHeight="430"
                                                      Background="{DynamicResource CardBrush}"
                                                      Foreground="{DynamicResource PrimaryTextBrush}"
                                                      RowBackground="{DynamicResource SurfaceBrush}"
                                                      AlternatingRowBackground="{DynamicResource CardBrush}"
                                                      BorderBrush="{DynamicResource BorderBrush}">
                                                <DataGrid.Columns>
                                                    <DataGridTextColumn Header="الاسم / Name" Binding="{Binding Name}" Width="160" SortMemberPath="Name" />
                                                    <DataGridTextColumn Header="المسار / Path" Binding="{Binding Path}" Width="260" SortMemberPath="Path" />
                                                    <DataGridTextColumn Header="الحجم / Size" Binding="{Binding SizeLabel}" Width="95" SortMemberPath="SortSizeBytes" />
                                                    <DataGridTextColumn Header="الامتداد / Extension" Binding="{Binding Extension}" Width="110" SortMemberPath="Extension" />
                                                    <DataGridTextColumn Header="النوع / Detected type" Binding="{Binding DetectedType}" Width="150" SortMemberPath="DetectedType" />
                                                    <DataGridTextColumn Header="التعديل / Modified" Binding="{Binding ModifiedLabel}" Width="150" SortMemberPath="SortLastModified" />
                                                    <DataGridTextColumn Header="التوقيع / Signature" Binding="{Binding SignatureLabel}" Width="170" SortMemberPath="SortSignatureStatus" />
                                                    <DataGridTextColumn Header="الناشر / Publisher" Binding="{Binding Publisher}" Width="150" SortMemberPath="Publisher" />
                                                    <DataGridTextColumn Header="مؤشر / Indicator" Binding="{Binding Warning}" Width="260" SortMemberPath="Warning" />
                                                </DataGrid.Columns>
                                            </DataGrid>

                                            <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                                <Button Content="{Binding CalculateHashLabel}"
                                                        Command="{Binding CalculateHashCommand}"
                                                        Padding="12,8"
                                                        Margin="0,0,8,0"
                                                        Cursor="Hand" />
                                                <Button Content="{Binding OpenLocationLabel}"
                                                        Command="{Binding OpenLocationCommand}"
                                                        Padding="12,8"
                                                        Cursor="Hand" />
                                                <TextBlock Text="{Binding SelectedResult.Sha256}"
                                                           Foreground="{DynamicResource SecondaryTextBrush}"
                                                           TextWrapping="Wrap"
                                                           VerticalAlignment="Center"
                                                           Margin="12,0,0,0" />
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>

                                    <Border Padding="18"
                                            Margin="0,0,0,16"
                                            Background="{DynamicResource SurfaceBrush}"
                                            BorderBrush="{DynamicResource BorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="14">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsOrganizer}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <StackPanel DataContext="{Binding Organizer}">
                                            <TextBlock Text="{Binding SafetyNotice}"
                                                       Foreground="{DynamicResource SecondaryTextBrush}"
                                                       TextWrapping="Wrap"
                                                       Margin="0,0,0,14" />

                                            <Grid Margin="0,0,0,8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0"
                                                           Text="{Binding SourceLabel}"
                                                           Foreground="{DynamicResource PrimaryTextBrush}"
                                                           VerticalAlignment="Center"
                                                           Margin="0,0,10,0" />
                                                <TextBox Grid.Column="1"
                                                         Text="{Binding SourceFolder, Mode=OneWay}"
                                                         IsReadOnly="True"
                                                         Padding="9,7"
                                                         Margin="0,0,8,0" />
                                                <Button Grid.Column="2"
                                                        Content="{Binding ChooseSourceLabel}"
                                                        Command="{Binding ChooseSourceFolderCommand}"
                                                        Padding="11,8"
                                                        Cursor="Hand" />
                                            </Grid>

                                            <Grid Margin="0,0,0,12">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0"
                                                           Text="{Binding DestinationLabel}"
                                                           Foreground="{DynamicResource PrimaryTextBrush}"
                                                           VerticalAlignment="Center"
                                                           Margin="0,0,10,0" />
                                                <TextBox Grid.Column="1"
                                                         Text="{Binding DestinationFolder, Mode=OneWay}"
                                                         IsReadOnly="True"
                                                         Padding="9,7"
                                                         Margin="0,0,8,0" />
                                                <Button Grid.Column="2"
                                                        Content="{Binding ChooseDestinationLabel}"
                                                        Command="{Binding ChooseDestinationFolderCommand}"
                                                        Padding="11,8"
                                                        Cursor="Hand" />
                                            </Grid>

                                            <WrapPanel Margin="0,0,0,12">
                                                <CheckBox Content="{Binding OrganizeByMonthLabel}"
                                                          IsChecked="{Binding OrganizeByMonth}"
                                                          VerticalAlignment="Center"
                                                          Margin="0,0,18,8" />
                                                <TextBlock Text="{Binding ConflictLabel}"
                                                           VerticalAlignment="Center"
                                                           Margin="0,0,8,8" />
                                                <ComboBox ItemsSource="{Binding ConflictOptions}"
                                                          SelectedItem="{Binding SelectedConflictOption}"
                                                          DisplayMemberPath="Label"
                                                          MinWidth="220"
                                                          Padding="6,4"
                                                          Margin="0,0,18,8" />
                                                <Button Content="{Binding PreviewLabel}"
                                                        Command="{Binding PreviewCommand}"
                                                        Padding="12,8"
                                                        Margin="0,0,8,8"
                                                        Cursor="Hand" />
                                                <Button Content="{Binding ExecuteLabel}"
                                                        Command="{Binding ExecuteCommand}"
                                                        Padding="12,8"
                                                        Margin="0,0,8,8"
                                                        Cursor="Hand" />
                                                <Button Content="{Binding CancelLabel}"
                                                        Command="{Binding CancelCommand}"
                                                        Padding="12,8"
                                                        Margin="0,0,8,8"
                                                        Cursor="Hand" />
                                                <Button Content="{Binding UndoLabel}"
                                                        Command="{Binding UndoCommand}"
                                                        Padding="12,8"
                                                        Margin="0,0,0,8"
                                                        Cursor="Hand" />
                                            </WrapPanel>

                                            <TextBlock Text="{Binding SummaryLabel}"
                                                       Foreground="{DynamicResource PrimaryTextBrush}"
                                                       FontWeight="SemiBold"
                                                       TextWrapping="Wrap"
                                                       Margin="0,0,0,8" />
                                            <ProgressBar Height="6"
                                                         Margin="0,0,0,8"
                                                         IsIndeterminate="{Binding IsWorking}">
                                                <ProgressBar.Style>
                                                    <Style TargetType="ProgressBar">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsWorking}" Value="True">
                                                                <Setter Property="Visibility" Value="Visible" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </ProgressBar.Style>
                                            </ProgressBar>
                                            <TextBlock Text="{Binding ProgressLabel}"
                                                       Foreground="{DynamicResource SecondaryTextBrush}"
                                                       Margin="0,0,0,8" />
                                            <TextBlock Text="{Binding Status}"
                                                       Foreground="{DynamicResource PrimaryTextBrush}"
