<Application x:Class="GhostHunterPC.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#10131A" />
        <SolidColorBrush x:Key="SidebarBackgroundBrush" Color="#151922" />
        <SolidColorBrush x:Key="SurfaceBrush" Color="#1B202B" />
        <SolidColorBrush x:Key="CardBrush" Color="#202633" />
        <SolidColorBrush x:Key="PrimaryTextBrush" Color="#F2F4F8" />
        <SolidColorBrush x:Key="SecondaryTextBrush" Color="#A6AFBF" />
        <SolidColorBrush x:Key="BorderBrush" Color="#303746" />
        <SolidColorBrush x:Key="AccentBrush" Color="#8B7CFF" />
        <SolidColorBrush x:Key="AccentSoftBrush" Color="#302B55" />
    </Application.Resources>
</Application>
